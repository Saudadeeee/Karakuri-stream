[resource]
# Vietnamese. The pixel face and Fredoka both stop at Latin-1, so every word
# with a Vietnamese diacritic came out as tofu boxes the moment the game was
# translated. Nunito (OFL, credited) carries the whole set and only ever draws
# the characters the other two do not have.
fallbacks = Array[Font]([ExtResource("2_nunito")])
base_font = ExtResource("1_65mqa")
variation_opentype = {
2003265652: 600
}
