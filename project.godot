; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="KARAKURI STREAM"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GridManager="*res://scripts/autoload/grid_manager.gd"
BlockMergeManager="*res://scripts/autoload/block_merge_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
WaterFlowManager="*res://scripts/autoload/water_flow_manager.gd"
DecorManager="*res://scripts/autoload/decor_manager.gd"
PondDecorManager="*res://scripts/autoload/pond_decor_manager.gd"
FireflyManager="*res://scripts/autoload/firefly_manager.gd"
GearManager="*res://scripts/autoload/gear_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
AmbientLeaves="*res://scripts/autoload/ambient_leaves.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
