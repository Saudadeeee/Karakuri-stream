; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="KARAKURI STREAM"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.957, 0.937, 0.886, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GridManager="*res://scripts/autoload/grid_manager.gd"
QualityManager="*res://scripts/autoload/quality_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
AmbientMusic="*res://scripts/autoload/ambient_music.gd"
WaterFlowManager="*res://scripts/autoload/water_flow_manager.gd"
StreamManager="*res://scripts/autoload/stream_manager.gd"
VoxelSurfaceManager="*res://scripts/autoload/voxel_surface_manager.gd"
DecorManager="*res://scripts/autoload/decor_manager.gd"
PondDecorManager="*res://scripts/autoload/pond_decor_manager.gd"
FireflyManager="*res://scripts/autoload/firefly_manager.gd"
GearManager="*res://scripts/autoload/gear_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
UndoManager="*res://scripts/autoload/undo_manager.gd"
AmbientLeaves="*res://scripts/autoload/ambient_leaves.gd"
SceneryManager="*res://scripts/autoload/scenery_manager.gd"
CloudSea="*res://scripts/autoload/cloud_sea.gd"
IslandBuilder="*res://scripts/autoload/island_builder.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/karakuri_theme.tres"
theme/custom_font="res://assets/fonts/Baloo2.ttf"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
