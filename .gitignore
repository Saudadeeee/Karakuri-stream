# Godot 4+ specific ignores
.godot/
/android/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Export output — regenerated by `tools/package.ps1`, not source.
# `export/.gdignore` is committed with `git add -f` so Godot never re-imports
# its own output as project assets (see docs/BUILD.md).
/export/
/builds/

# Claude Code session-local state (not project content)
/.claude/
build/

# Local editor tooling: the godot_mcp scene-bridge plugin (dev machine only,
# enabled in project.godot; a clone without it just logs a missing-plugin note)
/addons/godot_mcp/
